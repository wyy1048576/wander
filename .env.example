# Copy to .env.local and fill in. Never commit .env.local.
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_SPARK_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
# Google Cloud key with "Places API (New)" and "Routes API" enabled
GOOGLE_MAPS_API_KEY=
# liteAPI sandbox key (dashboard > Developer)
LITEAPI_KEY=
# Daily call caps enforced in code (lib/budget.ts)
MAX_GOOGLE_CALLS_PER_DAY=500
MAX_META_CALLS_PER_DAY=300
MAX_LITEAPI_CALLS_PER_DAY=300
